---
// Footer.astro — mirrors the header: strong rule, same wordmark, mono links.
// Split into two groups: site pages (internal) and elsewhere (external),
// so /contact and /privacy don't read as social profiles.
const pages = [
  { href: '/contact', label: 'Contact' },
  { href: '/privacy', label: 'Privacy' },
  { href: '/rss.xml', label: 'RSS' },
];

const elsewhere = [
  { href: 'https://github.com/nikxif', label: 'GitHub' },
  { href: 'https://medium.com/@nixifaras', label: 'Medium' },
  { href: 'mailto:info@ncxifaras.com', label: 'Email' },
];

interface Props {
  /** Set to 'en' by BaseLayout on non-English pages; the footer is English. */
  lang?: string;
}
const { lang } = Astro.props;

const year = new Date().getFullYear();
---

<footer class="site-footer" lang={lang}>
  <div class="container row">
    <div class="fmark">
      <span>ncxifaras<span class="dot">.</span>com</span>
      <span class="text-meta">© {year} · Nick Xifaras</span>
    </div>
    <div class="navs">
      <nav aria-label="Site">
        <ul>
          {
            pages.map((l) => (
              <li>
                <a href={l.href} class="link-plain flink">
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <nav aria-label="Elsewhere">
        <ul>
          {
            elsewhere.map((l) => (
              <li>
                <a href={l.href} class="link-plain flink">
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-7);
    border-top: var(--border-strong);
    padding-block: var(--space-4) var(--space-6);
  }

  .row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  /* Same Commissioner 800 wordmark as the header. The copyright line under it
     resets to body weight, or it inherits the 800. */
  .fmark {
    font-family: var(--font-display);
    font-weight: var(--weight-display);
    font-size: 1.15rem;
    letter-spacing: -0.01em;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .fmark .dot {
    color: var(--cobalt);
    font-weight: 700;
  }

  .fmark .text-meta {
    font-weight: var(--weight-body);
  }

  .navs {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    align-items: flex-end;
  }

  ul {
    display: flex;
    gap: var(--space-4);
    list-style: none;
    padding: 0;
  }

  .flink {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--ink-soft);
    transition: color var(--transition-quick);
  }

  .flink:hover {
    color: var(--cobalt-deep);
  }

  @media (max-width: 640px) {
    .navs {
      align-items: flex-start;
    }
  }

  /* Touch: ~44px targets, with the row gap absorbed into them so the footer
     doesn't grow much. */
  @media (pointer: coarse) {
    .navs {
      gap: 0;
    }

    .flink {
      display: inline-flex;
      align-items: center;
      min-height: 2.75rem;
    }
  }
</style>
