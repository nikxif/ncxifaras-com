---
// Header.astro — four items, because five didn't fit a phone and "Blog" vs
// "Writing" was a distinction no reader could explain. "Writing" is the full
// archive; the curated /writing view (D3) stays reachable but is no longer
// a nav item while nothing published is featured.
const nav = [
  { href: '/about', label: 'About' },
  { href: '/cv', label: 'CV' },
  { href: '/posts', label: 'Writing', also: ['/writing', '/tags'] },
  { href: '/contact', label: 'Contact' },
];

const { pathname } = Astro.url;
const under = (href: string) => pathname === href || pathname.startsWith(href + '/');
const isActive = (item: (typeof nav)[number]) =>
  under(item.href) || (item.also ?? []).some(under);
---

<header class="site-header">
  <div class="container bar">
    <a href="/" class="mark link-plain" aria-label="Home">
      ncxifaras<span class="dot">.</span>com
    </a>
    <nav aria-label="Main">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                class="link-plain nav-link"
                aria-current={isActive(item) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--paper);
    border-bottom: var(--border-strong);
  }

  /* Wraps instead of overflowing: on the narrowest phones the nav drops under
     the wordmark rather than colliding with it (it used to clip "Contact").
     min-height keeps the single-row bar at its familiar 4rem. */
  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    column-gap: var(--space-4);
    row-gap: var(--space-2);
    min-height: 4rem;
    padding-block: var(--space-3);
  }

  .mark {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    letter-spacing: 0.02em;
  }

  .dot {
    color: var(--cobalt);
    font-weight: 700;
  }

  nav ul {
    display: flex;
    gap: var(--space-4);
    list-style: none;
    padding: 0;
  }

  .nav-link {
    position: relative;
    font-family: var(--font-display);
    font-size: 0.94rem;
    font-weight: 600;
    padding-bottom: 2px;
    border-bottom: 2px solid transparent;
    transition: border-color var(--transition-quick);
  }

  .nav-link:hover,
  .nav-link[aria-current='page'] {
    border-color: var(--cobalt);
    color: inherit;
  }

  @media (max-width: 640px) {
    nav ul {
      gap: var(--space-3);
    }
  }

  /* Touch: grow the hit area to ~44px without moving the text or the
     underline — an invisible box around each link. */
  @media (pointer: coarse) {
    .nav-link::before {
      content: '';
      position: absolute;
      inset: -0.6rem -0.4rem;
    }
  }
</style>
