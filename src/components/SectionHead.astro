---
// SectionHead.astro — the bold, obvious section heading (DESIGN.md: headings
// should never be easy to miss). Strong rule underneath, optional mono count
// and an "all →" link on the right. `quiet` is the step down for an ending
// (a post's "Read next"): the article's own h2 size and a hairline, so the
// author's last paragraph stays the end of the page.
interface Props {
  title: string;
  quiet?: boolean;
  count?: string | number;
  moreHref?: string;
  moreLabel?: string;
}

const { title, quiet = false, count, moreHref, moreLabel = 'all →' } = Astro.props;
---

<div class:list={['sec-head', { quiet }]}>
  <h2>{title}</h2>
  {count !== undefined && <span class="text-meta">/ {count}</span>}
  {
    moreHref && (
      <a href={moreHref} class="link-plain more">
        {moreLabel}
      </a>
    )
  }
</div>

<style>
  .sec-head {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    border-bottom: var(--border-strong);
    padding-bottom: var(--space-2);
    margin-bottom: var(--space-5);
  }

  h2 {
    font-size: var(--text-2xl);
  }

  .quiet {
    border-bottom: var(--border-hair);
    margin-bottom: var(--space-4);
  }

  .quiet h2 {
    font-size: var(--text-xl);
  }

  .more {
    position: relative;
    margin-left: auto;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--cobalt-deep);
    border-bottom: 2px solid transparent;
    transition: border-color var(--transition-quick);
  }

  .more:hover {
    border-color: var(--cobalt);
  }

  /* Touch: stretch the hit area to ~44px without moving the text. */
  @media (pointer: coarse) {
    .more::before {
      content: '';
      position: absolute;
      inset: -0.8rem -0.5rem;
    }
  }
</style>
