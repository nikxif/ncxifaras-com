---
// Sidenote.astro — the signature element (paragraph-anchored rebuild).
//
// Authoring: place it INLINE, mid-sentence, exactly where the marker should
// sit:  ...the main claim.<Sidenote>the aside</Sidenote> The next sentence...
// (Works in .mdx only — .md can't import components.)
//
// How the desktop margin placement works (and why it's robust):
//   - The note body is position:absolute.
//   - Its containing block is the PARAGRAPH (PostLayout sets
//     `.prose p { position: relative }`), NOT the inline wrapper (which is
//     static). So the note ignores where mid-sentence the marker sits and
//     anchors to the paragraph box instead.
//   - `left: 100%` → the paragraph's right edge; every paragraph is the same
//     width (--width-content), so every note gets the SAME x  → they line up
//     in one column.  `top: 0` → the paragraph's top → vertical alignment to
//     the paragraph the note belongs to.
//   - Always visible on desktop; no toggle, no JS.
//
// Mobile: no room for a margin, so the body collapses behind a [n] marker and
// expands inline on tap (pure-CSS checkbox — CSP-safe, no inline script).
//
// Accessibility, by mode:
//   - Narrow (<70rem): a real disclosure. The checkbox is focusable and named
//     by its label ("Sidenote [1]": the word is CSS-generated, visually
//     hidden), the focus ring is drawn on the visible marker, and an open
//     note keeps its marker tinted.
//   - Margin (≥70rem): the note is always on screen, so the checkbox is
//     display:none — out of the tab order and the accessibility tree — and a
//     screen reader reads "Sidenote 1" then the note, inline, in order.
//
// Numbering: a single counter-increment on the wrapper (labelled notes still
// increment, so a custom label like † doesn't desync the following numbers).
// The body repeats its number, so a margin note can be matched to its marker.

interface Props {
  /** Optional custom marker (e.g. "†") instead of the running number. */
  label?: string;
}
const { label } = Astro.props;
const id = 'sn-' + Math.random().toString(36).slice(2, 9);
---

<span class="sidenote-wrap">
  <input type="checkbox" id={id} class="sn-toggle" />
  <label for={id} class="sn-marker" data-label={label}><span class="sn-name"></span></label>
  <small class="sn-body" role="note" data-label={label}><slot /></small>
</span>

<style>
  /* The wrapper is the ONLY place the counter advances. */
  .sidenote-wrap {
    counter-increment: sidenote;
  }

  .sn-marker {
    font-family: var(--font-mono);
    font-size: 0.72em;
    line-height: 0;
    vertical-align: super;
    color: var(--cobalt-deep);
    padding-inline: 0.12em;
    border-radius: var(--radius);
  }
  .sn-marker::after {
    content: counter(sidenote);
  }
  .sn-marker[data-label]::after {
    content: attr(data-label);
  }

  /* The accessible name's word — read, never shown. */
  .sn-name {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .sn-name::before {
    content: 'Sidenote ';
  }

  .sn-body {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    line-height: 1.5;
    color: var(--ink-soft);
    border-left: 3px solid var(--ochre);
    padding-left: 0.9rem;
  }
  .sn-body::before {
    content: counter(sidenote) '\00a0\00a0';
    color: var(--cobalt-deep);
    font-weight: var(--weight-medium);
  }
  .sn-body[data-label]::before {
    content: attr(data-label) '\00a0\00a0';
  }
  .sn-body :global(a) {
    color: var(--cobalt-deep);
  }

  /* Visually hidden but focusable (narrow mode); the ring goes on the marker. */
  .sn-toggle {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* ---- DESKTOP (≥70rem): always visible, anchored to the paragraph -------
     Breakpoint matches PostLayout: only switch to margin mode when the
     viewport actually fits text + gap + note column. */
  @media (min-width: 70rem) {
    .sidenote-wrap {
      position: static; /* ensure the paragraph, not this span, is the CB */
    }
    .sn-toggle {
      display: none; /* nothing to toggle: drop the tab stop */
    }
    .sn-body {
      position: absolute;
      left: 100%;              /* → paragraph right edge (same for every note) */
      top: 0;                  /* → paragraph top */
      margin-left: 2rem;       /* the gutter; matches PostLayout's reserve */
      width: var(--width-sidenote);
      display: block;
    }
    /* marker stays a quiet superscript number: not a control here, so no
       pointer and no hover wash */
  }

  /* ---- MOBILE / NARROW (<70rem): collapse behind the [n] marker ---------- */
  @media (max-width: 69.999rem) {
    /* A highlighter wash at rest, so the marker reads as something to tap
       (the underline alone read as a footnote number). It's the same ochre as
       ::selection and the note's own rule. Opening deepens it. */
    .sn-marker {
      position: relative;
      cursor: pointer;
      padding-inline: 0.3em;
      background: color-mix(in srgb, var(--ochre) 30%, transparent);
    }
    /* Invisible hit area around the tiny marker. Kept under a full line-height
       so a tap on the neighbouring line doesn't open the note. */
    .sn-marker::before {
      content: '';
      position: absolute;
      inset: -0.8em -0.5em;
    }
    /* Touch: widen the hit area to ~44px across. Height stays under a line so
       a tap on the neighbouring line doesn't open the note. */
    @media (pointer: coarse) {
      .sn-marker::before {
        inset: -0.8em -1.2em;
      }
    }
    .sn-marker::after {
      content: '[' counter(sidenote) ']';
    }
    .sn-marker[data-label]::after {
      content: '[' attr(data-label) ']';
    }
    .sn-marker:hover,
    .sn-toggle:checked + .sn-marker {
      color: var(--cobalt-deep);
      background: color-mix(in srgb, var(--ochre) 60%, transparent);
    }
    .sn-toggle:focus-visible + .sn-marker {
      outline: 3px solid var(--ink);
      outline-offset: 2px;
      box-shadow: 0 0 0 6px color-mix(in srgb, var(--ochre) 55%, transparent);
    }
    .sn-body {
      display: none;
      margin-block: var(--space-2);
    }
    .sn-toggle:checked ~ .sn-body {
      display: block;
    }
  }
</style>
