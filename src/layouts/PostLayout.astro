---
// PostLayout.astro — renders a single post.
// Prose column is --width-content; at ≥70rem the room to its right is the
// sidenote margin. No cover here: covers belong to cards and the OG image,
// and every on-page placement tried (above, below, in the margin) was worse.
import BaseLayout from './BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import SectionHead from '../components/SectionHead.astro';
import ShareButtons from '../components/ShareButtons.astro';
import { CATEGORY_LABELS, formatDate, getPublishedPosts, typeset, type Post } from '../lib/posts';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { pubDate, updatedDate, category, tags, canonicalURL, lang } = post.data;
const title = typeset(post.data.title);
const description = typeset(post.data.description);
// The post's own chrome (chip, date, share) is English even on a Greek post
// (D30); mark it so a Greek screen-reader voice switches for it.
const chromeLang = lang === 'en' ? undefined : 'en';

// One forward path at the end, picked at build time: the nearest older post
// in the same category, else the nearest newer one, else the newest other
// post. (Posts are newest-first.)
const others = (await getPublishedPosts()).filter((p) => p.id !== post.id);
const sameCat = others.filter((p) => p.data.category === category);
const next =
  sameCat.find((p) => p.data.pubDate < pubDate) ??
  sameCat.findLast((p) => p.data.pubDate >= pubDate) ??
  others[0];
---

<BaseLayout
  title={`${title} — Nick Xifaras`}
  ogTitle={title}
  {description}
  {canonicalURL}
  {lang}
  ogType="article"
  ogImage={`/og/${post.id}.png`}
  published={pubDate}
  modified={updatedDate}
>
  <article class="container post">
    <header class="post-head">
      <span class:list={['cat-bar', `cat-${category}`]} aria-hidden="true"></span>
      <p class="meta text-meta" lang={chromeLang}>
        <span class:list={['chip', `cat-${category}`]}>{CATEGORY_LABELS[category]}</span>
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
        {
          updatedDate && (
            <span>
              · updated <time datetime={updatedDate.toISOString()}>{formatDate(updatedDate)}</time>
            </span>
          )
        }
      </p>
      <h1>{title}</h1>
      <p class="text-lede dek">{description}</p>
    </header>

    <div class="prose">
      <slot />
    </div>

    <footer class="post-foot" lang={chromeLang}>
      {
        tags.length > 0 && (
          <ul class="tags">
            {tags.map((tag) => (
              <li>
                <a href={`/tags/${encodeURIComponent(tag)}`} class="link-plain tag">
                  #{tag}
                </a>
              </li>
            ))}
          </ul>
        )
      }
      <ShareButtons title={title} url={new URL(Astro.url.pathname, Astro.site).href} />
    </footer>
  </article>

  {
    next && (
      <section class="container post-next" lang={chromeLang}>
        <SectionHead title="Read next" moreHref="/posts" moreLabel="all writing →" />
        <PostCard post={next} compact />
      </section>
    )
  }
</BaseLayout>

<style>
  .post {
    max-width: var(--width-content);
    padding-block: var(--space-6) var(--space-5);
  }

  /* After the article: one forward path, set apart by a full section break
     (same SectionHead as the homepage's "Writing"). Declared before the
     ≥70rem block so the wide-screen alignment below can override it. */
  .post-next {
    max-width: var(--width-content);
    padding-block: var(--space-4) var(--space-5);
  }

  /* At ≥70rem the article takes the full container, so its left edge sits on
     the same line as the header wordmark and the footer; the text stays
     capped at --width-content and the sidenote column (content + 2rem gap +
     16rem, ≈70rem with page margins, so notes never clip) follows it.
     Centring a narrower 64rem box put the text ~3rem off that line. */
  @media (min-width: 70rem) {
    .post {
      max-width: var(--width-wide);
    }

    .post-head,
    .post-foot,
    .prose {
      max-width: var(--width-content);
    }

    /* Full container width on purpose: the section break spans the page like
       the homepage's, signalling the article is over and the site resumes. */
    .post-next {
      max-width: var(--width-wide);
    }
    /* NB: the paragraph positioning-context rule lives in the is:global block
       below — markdown-generated <p> elements don't carry this component's
       scope hash, so a scoped selector wouldn't reach them. */
  }

  .post-head {
    margin-bottom: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  /* The post's one spend of colour in the header: a short, thick bar in its
     category colour, the same vocabulary as the homepage's bar and the 4rem
     ink rule in the prose. Colour as a line, never a pill or a fill
     (Colour-Is-Category, Ink-Rule). Decorative — the chip beside the date
     carries the category as text — so it's hidden from assistive tech and
     exempt from the 3:1 non-text rule (ochre is ~2:1 on paper, by design). */
  .cat-bar {
    display: block;
    width: 4rem;
    height: 0.4rem;
    margin-bottom: var(--space-2);
    background: var(--_cat, var(--ink));
  }

  .meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    font-weight: var(--weight-medium);
  }

  .chip::before {
    content: '';
    width: 0.62em;
    height: 0.62em;
    border-radius: 1px;
    background: var(--_cat, var(--ink));
  }

  .cat-project  { --_cat: var(--cat-project); }
  .cat-guide    { --_cat: var(--cat-guide); }
  .cat-opinion  { --_cat: var(--cat-opinion); }
  .cat-personal { --_cat: var(--cat-personal); }

  .dek {
    color: var(--ink-soft);
  }

  /* One band of metadata after the article, under a single hairline. Tags and
     share controls are deliberately STACKED — the prose column isn't wide
     enough to hold both on one line, so relying on flex-wrap made the layout
     depend on how many tags a post happened to have. Explicit column keeps
     every post identical. Gap is paragraph-sized so the two rows read as
     separate items rather than one crowded block. */
  .post-foot {
    margin-top: var(--space-5);
    border-top: var(--border-hair);
    padding-top: var(--space-3);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .tag {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--ink-soft);
  }

  .tag:hover {
    color: var(--cobalt-deep);
  }
</style>

<style is:global>
  /* Only the two post-specific prose rules live here (D19); all other .prose
     typography is in global.css, so /about and friends get it too. Global
     (not scoped) because it must reach rendered markdown, which carries no
     scope hash. */
  .prose {
    counter-reset: sidenote; /* powers <Sidenote> auto-numbering */
  }

  /* Desktop only: make each text block the containing block for a sidenote
     authored inside it, so the note anchors to the paragraph (right edge + top)
     rather than to the inline marker. Global because these <p>/<li> come from
     rendered markdown and carry no scope hash. Matches Sidenote's breakpoint. */
  @media (min-width: 70rem) {
    .prose :is(p, li, blockquote) {
      position: relative;
    }
  }
</style>
