---
// PostLayout.astro — renders a single post.
// Prose column is --width-content; at ≥70rem the room to its right is the
// sidenote margin. No cover here: covers belong to cards and the OG image,
// and every on-page placement tried (above, below, in the margin) was worse.
import BaseLayout from './BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import SectionHead from '../components/SectionHead.astro';
import ShareButtons from '../components/ShareButtons.astro';
import type { MarkdownHeading } from 'astro';
import {
  CATEGORY_LABELS,
  formatDate,
  getPublishedPosts,
  typeset,
  type Post,
} from '../lib/posts';

interface Props {
  post: Post;
  headings?: MarkdownHeading[];
}

const { post, headings = [] } = Astro.props;
const { pubDate, updatedDate, category, tags, canonicalURL, lang } = post.data;
const title = typeset(post.data.title);
const description = typeset(post.data.description);
// The post's own chrome (chip, date, share) is English even on a Greek post
// (D30); mark it so a Greek screen-reader voice switches for it.
const chromeLang = lang === 'en' ? undefined : 'en';

// A way around the long guides: the contents show from 4 sections up. A
// one-screen post doesn't need them.
const sections = headings.filter((h) => h.depth === 2);

// One forward path at the end, picked at build time: the nearest older post
// in the same category, else the nearest newer one, else the newest other
// post. (Posts are newest-first.)
const others = (await getPublishedPosts()).filter((p) => p.id !== post.id);
const sameCat = others.filter((p) => p.data.category === category);
const next =
  sameCat.find((p) => p.data.pubDate < pubDate) ??
  sameCat.findLast((p) => p.data.pubDate >= pubDate) ??
  others[0];
---

<BaseLayout
  title={`${title} — Nick Xifaras`}
  ogTitle={title}
  {description}
  {canonicalURL}
  {lang}
  ogType="article"
  ogImage={`/og/${post.id}.png`}
  published={pubDate}
  modified={updatedDate}
>
  <article class="container post">
    <header class="post-head">
      <p class="meta text-meta" lang={chromeLang}>
        <span class:list={['meta-main', `cat-${category}`]}>
          <span class="chip">{CATEGORY_LABELS[category]}</span>
          <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
        </span>
        {
          updatedDate && (
            <span>
              · updated <time datetime={updatedDate.toISOString()}>{formatDate(updatedDate)}</time>
            </span>
          )
        }
      </p>
      <h1>{title}</h1>
      <p class="text-lede dek">{description}</p>
      {
        sections.length >= 4 && (
          <details class="toc" lang={chromeLang}>
            <summary>
              Contents <span class="toc-count">/ {sections.length}</span>
            </summary>
            <ul>
              {sections.map((h) => (
                <li>
                  <a href={`#${h.slug}`} class="link-plain" lang={chromeLang && lang}>
                    {h.text}
                  </a>
                </li>
              ))}
            </ul>
          </details>
        )
      }
    </header>

    <div class="prose">
      <slot />
    </div>

    <footer class="post-foot" lang={chromeLang}>
      {
        tags.length > 0 && (
          <ul class="tags">
            {tags.map((tag) => (
              <li>
                <a href={`/tags/${encodeURIComponent(tag)}`} class="link-plain tag">
                  #{tag}
                </a>
              </li>
            ))}
          </ul>
        )
      }
      <ShareButtons title={title} url={new URL(Astro.url.pathname, Astro.site).href} />
    </footer>
  </article>

  {
    next && (
      <section class="container post-next" lang={chromeLang}>
        <SectionHead title="Read next" quiet moreHref="/posts" moreLabel="all posts →" />
        <PostCard post={next} compact />
      </section>
    )
  }
</BaseLayout>

<style>
  .post {
    max-width: var(--width-content);
    padding-block: var(--space-6) var(--space-5);
  }

  /* After the article: one forward path, set apart by a full section break
     (same SectionHead as the homepage's "Writing"). Declared before the
     ≥70rem block so the wide-screen alignment below can override it. */
  .post-next {
    max-width: var(--width-content);
    padding-block: var(--space-4) var(--space-5);
  }

  /* At ≥70rem the article takes the full container, so its left edge sits on
     the same line as the header wordmark and the footer; the text stays
     capped at --width-content and the sidenote column (content + 2rem gap +
     16rem, ≈70rem with page margins, so notes never clip) follows it.
     Centring a narrower 64rem box put the text ~3rem off that line. */
  @media (min-width: 70rem) {
    .post {
      max-width: var(--width-wide);
    }

    .post-head,
    .post-foot,
    .prose {
      max-width: var(--width-content);
    }

    /* Full container width on purpose: the section break spans the page like
       the homepage's, signalling the article is over and the site resumes. */
    .post-next {
      max-width: var(--width-wide);
    }
    /* NB: the paragraph positioning-context rule lives in the is:global block
       below — markdown-generated <p> elements don't carry this component's
       scope hash, so a scoped selector wouldn't reach them. */
  }

  .post-head {
    margin-bottom: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  /* The post's one spend of colour in the header: a thick rule in the category
     colour set under the chip and the date, as if underlining them, and ending
     with the date. Colour as a line, never a pill or a fill (Colour-Is-Category,
     Ink-Rule). It's the border of the chip+date group, so its length follows the
     text at any width. Decorative — the chip carries the category as text — so
     it's exempt from the 3:1 non-text rule (ochre is ~2:1 on paper, by design).
     The gap under the text is 0.62em, the size of the chip's colour square. */
  .meta-main {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    padding-bottom: 0.62em;
    border-bottom: 0.4rem solid var(--_cat, var(--ink));
  }

  .meta {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    font-weight: var(--weight-medium);
  }

  .chip::before {
    content: '';
    width: 0.62em;
    height: 0.62em;
    border-radius: 1px;
    background: var(--_cat, var(--ink));
  }

  .cat-project  { --_cat: var(--cat-project); }
  .cat-guide    { --_cat: var(--cat-guide); }
  .cat-opinion  { --_cat: var(--cat-opinion); }
  .cat-personal { --_cat: var(--cat-personal); }

  .dek {
    color: var(--ink-soft);
  }

  /* Contents for long guides: a native disclosure, closed by default so the
     first screen stays the title and the first paragraph. Hairlines, not a
     box: the same quiet furniture as the post footer. No numbers; the order is
     the page's own. */
  .toc {
    border-block: var(--border-hair);
    padding-block: var(--space-2);
  }

  .toc summary {
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--ink-soft);
    padding-block: var(--space-1);
  }

  .toc summary::marker {
    color: var(--cobalt-deep);
  }

  .toc-count {
    margin-left: 0.4em;
  }

  .toc ul {
    list-style: none;
    padding: 0;
    margin: var(--space-2) 0 var(--space-1);
  }

  .toc li a {
    display: block;
    padding-block: 0.3rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.94rem;
    line-height: 1.35;
  }

  .toc li a:hover {
    color: var(--cobalt-deep);
  }

  @media (pointer: coarse) {
    .toc summary,
    .toc li a {
      display: flex;
      align-items: center;
      min-height: 2.75rem;
    }
  }

  /* On a phone the fluid h1 floor (2.4rem) wrapped long titles to five or six
     heavy lines before the first paragraph. Cap it at the Headline step for post titles only; the
     homepage hero keeps the full scale. */
  @media (max-width: 640px) {
    h1 {
      font-size: var(--text-2xl);
    }
  }

  /* One band of metadata after the article, under a single hairline. Tags and
     share controls are deliberately STACKED — the prose column isn't wide
     enough to hold both on one line, so relying on flex-wrap made the layout
     depend on how many tags a post happened to have. Explicit column keeps
     every post identical. Gap is paragraph-sized so the two rows read as
     separate items rather than one crowded block. */
  .post-foot {
    margin-top: var(--space-5);
    border-top: var(--border-hair);
    padding-top: var(--space-3);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .tag {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--ink-soft);
  }

  .tag:hover {
    color: var(--cobalt-deep);
  }

  /* Touch: grow tags to a ~44px target. The share buttons get the same in
     ShareButtons.astro. */
  @media (pointer: coarse) {
    .tags {
      gap: 0 var(--space-3);
    }

    .tag {
      display: inline-flex;
      align-items: center;
      min-height: 2.75rem;
    }
  }
</style>

<style is:global>
  /* Only the two post-specific prose rules live here (D19); all other .prose
     typography is in global.css, so /about and friends get it too. Global
     (not scoped) because it must reach rendered markdown, which carries no
     scope hash. */
  .prose {
    counter-reset: sidenote; /* powers <Sidenote> auto-numbering */
  }

  /* Desktop only: make each text block the containing block for a sidenote
     authored inside it, so the note anchors to the paragraph (right edge + top)
     rather than to the inline marker. Global because these <p>/<li> come from
     rendered markdown and carry no scope hash. Matches Sidenote's breakpoint. */
  @media (min-width: 70rem) {
    .prose :is(p, li, blockquote) {
      position: relative;
    }
  }
</style>
