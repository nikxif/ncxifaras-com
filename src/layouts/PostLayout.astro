---
// PostLayout.astro — renders a single post.
// Prose column is --width-content; at ≥70rem the room to its right is the
// sidenote margin. The post's cover leads the page, so a post page carries
// the same poster as its card and its OG image.
import BaseLayout from './BaseLayout.astro';
import Cover from '../components/Cover.astro';
import ShareButtons from '../components/ShareButtons.astro';
import { CATEGORY_LABELS, formatDate, type Post } from '../lib/posts';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { title, description, pubDate, updatedDate, category, tags, canonicalURL, lang } =
  post.data;
// The post's own chrome (chip, date, share) is English even on a Greek post
// (D30); mark it so a Greek screen-reader voice switches for it.
const chromeLang = lang === 'en' ? undefined : 'en';
---

<BaseLayout
  title={`${title} — Nick Xifaras`}
  {description}
  {canonicalURL}
  {lang}
  ogType="article"
  ogImage={`/og/${post.id}.png`}
  published={pubDate}
  modified={updatedDate}
>
  <article class="container post">
    <div class="post-cover">
      <Cover {post} page />
    </div>
    <header class="post-head">
      <p class="meta text-meta" lang={chromeLang}>
        <span class:list={['chip', `cat-${category}`]}>{CATEGORY_LABELS[category]}</span>
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
        {
          updatedDate && (
            <span>
              · updated <time datetime={updatedDate.toISOString()}>{formatDate(updatedDate)}</time>
            </span>
          )
        }
      </p>
      <h1>{title}</h1>
      <p class="text-lede dek">{description}</p>
    </header>

    <div class="prose">
      <slot />
    </div>

    <footer class="post-foot" lang={chromeLang}>
      {
        tags.length > 0 && (
          <ul class="tags">
            {tags.map((tag) => (
              <li>
                <a href={`/tags/${encodeURIComponent(tag)}`} class="link-plain tag">
                  #{tag}
                </a>
              </li>
            ))}
          </ul>
        )
      }
      <ShareButtons title={title} url={new URL(Astro.url.pathname, Astro.site).href} />
    </footer>
  </article>
</BaseLayout>

<style>
  .post {
    max-width: var(--width-content);
    padding-block: var(--space-6) var(--space-5);
  }

  /* The poster that leads the page: the post's own cover at the text column's
     width. The chip directly below names the category, so the cover drops
     its overlay label here (Cover's `page` mode). */
  .post-cover {
    margin-bottom: var(--space-5);
  }

  /* At ≥70rem the article takes the full container, so its left edge sits on
     the same line as the header wordmark and the footer; the text stays
     capped at --width-content and the sidenote column (content + 2rem gap +
     16rem, ≈70rem with page margins, so notes never clip) follows it.
     Centring a narrower 64rem box put the text ~3rem off that line. */
  @media (min-width: 70rem) {
    .post {
      max-width: var(--width-wide);
    }

    .post-cover,
    .post-head,
    .post-foot,
    .prose {
      max-width: var(--width-content);
    }
    /* NB: the paragraph positioning-context rule lives in the is:global block
       below — markdown-generated <p> elements don't carry this component's
       scope hash, so a scoped selector wouldn't reach them. */
  }

  .post-head {
    margin-bottom: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    font-weight: var(--weight-medium);
  }

  .chip::before {
    content: '';
    width: 0.62em;
    height: 0.62em;
    border-radius: 1px;
    background: var(--_cat, var(--ink));
  }

  .cat-project  { --_cat: var(--cat-project); }
  .cat-guide    { --_cat: var(--cat-guide); }
  .cat-opinion  { --_cat: var(--cat-opinion); }
  .cat-personal { --_cat: var(--cat-personal); }

  .dek {
    color: var(--ink-soft);
  }

  /* One band of metadata after the article: a single hairline, tags on the
     left, share controls on the right. Previously these were two sibling
     blocks each with its own border, which read as a ladder of empty strips. */
  /* One band of metadata after the article, under a single hairline. Tags and
     share controls are deliberately STACKED — the prose column isn't wide
     enough to hold both on one line, so relying on flex-wrap made the layout
     depend on how many tags a post happened to have. Explicit column keeps
     every post identical. Gap is paragraph-sized so the two rows read as
     separate items rather than one crowded block. */
  .post-foot {
    margin-top: var(--space-5);
    border-top: var(--border-hair);
    padding-top: var(--space-3);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .tag {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--ink-soft);
  }

  .tag:hover {
    color: var(--cobalt-deep);
  }
</style>

<style is:global>
  /* Long-form prose typography. Global (not scoped) because it must reach
     the rendered markdown, which Astro injects without scope hashes. */
  .prose {
    counter-reset: sidenote; /* powers <Sidenote> auto-numbering */
  }

  .prose > * + * {
    margin-top: var(--space-3);
  }

  /* Desktop only: make each text block the containing block for a sidenote
     authored inside it, so the note anchors to the paragraph (right edge + top)
     rather than to the inline marker. Global because these <p>/<li> come from
     rendered markdown and carry no scope hash. Matches Sidenote's breakpoint. */
  @media (min-width: 70rem) {
    .prose :is(p, li, blockquote) {
      position: relative;
    }
  }

  .prose h2,
  .prose h3 {
    margin-top: var(--space-5);
  }

  .prose h2 {
    font-size: var(--text-xl);
    border-bottom: var(--border-hair);
    padding-bottom: var(--space-1);
  }

  .prose h3 {
    font-size: var(--text-lg);
  }

  .prose ul,
  .prose ol {
    padding-left: 1.4em;
  }

  .prose li + li {
    margin-top: var(--space-1);
  }

  .prose blockquote {
    border-left: 3px solid var(--ochre);
    padding-left: var(--space-3);
    color: var(--ink-soft);
    font-style: italic;
  }

  .prose code {
    font-family: var(--font-mono);
    font-size: 0.86em;
    background: var(--paper-2);
    padding: 0.12em 0.35em;
    border-radius: var(--radius);
  }

  .prose pre {
    border: var(--border-hair);
    border-radius: var(--radius);
    padding: var(--space-3);
    overflow-x: auto;
    font-size: 0.86rem;
    line-height: 1.55;
  }

  .prose pre code {
    background: none;
    padding: 0;
    font-size: inherit;
  }

  .prose img {
    border: var(--border-strong);
    border-radius: var(--radius);
  }

  .prose hr {
    border: 0;
    border-top: var(--border-strong);
    width: 4rem;
    margin-inline: 0;
    margin-block: var(--space-5);
  }
</style>
