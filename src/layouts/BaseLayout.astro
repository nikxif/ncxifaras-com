---
// BaseLayout.astro — the shell every page renders inside. (Phase 2 revision:
// adds <Analytics/>. Otherwise identical to Phase 1.)
import '@fontsource-variable/commissioner';
//import '@fontsource-variable/alegreya'; OLD FONT
import '@fontsource-variable/source-serif-4/opsz.css';
//import '@fontsource-variable/alegreya/wght-italic.css'; OLD FONT
import '@fontsource-variable/source-serif-4/opsz-italic.css';
import '@fontsource-variable/jetbrains-mono';
// Real italics for sidenotes and captions (mono). Without this the browser
// slants the roman. Fetched only on pages that actually set mono italic.
import '@fontsource-variable/jetbrains-mono/wght-italic.css';

// Preload the two faces every first screen sets (Commissioner: wordmark, nav,
// h1; Source Serif: body), latin subset only. Without this the browser only
// discovers them after parsing the CSS. ?url resolves to the same hashed
// /_astro/ file the @font-face rules point at, so nothing downloads twice.
import displayFontURL from '@fontsource-variable/commissioner/files/commissioner-latin-wght-normal.woff2?url';
import bodyFontURL from '@fontsource-variable/source-serif-4/files/source-serif-4-latin-opsz-normal.woff2?url';

import '../styles/tokens.css';
import '../styles/global.css';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Analytics from '../components/Analytics.astro';
import { OG_LOCALE, type Lang } from '../lib/i18n';

interface Props {
  title: string;
  /** Title for shared-link cards, when it should differ from <title> (posts
      drop the " — Nick Xifaras" suffix: the card already shows the domain). */
  ogTitle?: string;
  description: string;
  ogImage?: string;
  canonicalURL?: string;
  /** Language of the page's content (posts can be Greek). Defaults to English. */
  lang?: Lang;
  /** 'article' for posts; everything else is a 'website'. */
  ogType?: 'website' | 'article';
  /** Posts only: emitted as article:published_time / article:modified_time. */
  published?: Date;
  modified?: Date;
}

const {
  title,
  ogTitle = title,
  description,
  ogImage,
  canonicalURL,
  lang = 'en',
  ogType = 'website',
  published,
  modified,
} = Astro.props;
// Site chrome (skip link, header, footer) is always English. On a Greek page
// mark it, so screen readers switch voice for it instead of reading English
// with Greek phonetics.
const chromeLang = lang === 'en' ? undefined : 'en';

const canonical = canonicalURL ?? new URL(Astro.url.pathname, Astro.site).href;
// Per-post pages pass a generated /og/<id>.png; everything else falls back to
// the site card so every shared link has an on-brand 1200×630 preview.
const ogImageURL = new URL(ogImage ?? '/og-default.png', Astro.site).href;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <link rel="preload" href={displayFontURL} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={bodyFontURL} as="font" type="font/woff2" crossorigin />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Nick Xifaras — RSS"
      href={new URL('rss.xml', Astro.site)}
    />

    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content={OG_LOCALE[lang]} />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {modified && <meta property="article:modified_time" content={modified.toISOString()} />}
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImageURL} />
  </head>

  <body>
    <a href="#main" class="skip-link" lang={chromeLang}>Skip to content</a>
    <Header lang={chromeLang} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={chromeLang} />
    <Analytics />
  </body>
</html>
