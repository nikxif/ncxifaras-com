---
// index.astro — the landing page. Positioning first (hero as thesis),
// then featured + recent writing. NOT a blog river (ARCHITECTURE.md).
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import SectionHead from '../components/SectionHead.astro';
import { getPublishedPosts } from '../lib/posts';

const posts = await getPublishedPosts();
const featured = posts.filter((p) => p.data.featured);
// Lead with the newest featured post if there is one, else the newest post.
const lead = featured[0] ?? posts[0];
const rest = posts.filter((p) => p !== lead).slice(0, 3);
---

<BaseLayout
  title="Nick Xifaras — physician & software developer"
  description="A doctor who writes code, working across clinical medicine, digital-health policy, and the messy seams between them. Moving toward neuroscience and brain–computer interfaces."
>
  <section class="container hero">
    <div>
      <p class="eyebrow">physician / software developer · athens</p>
      <h1>
        I build the tools<br />clinical work<br /><span class="last-line">keeps breaking.</span>
      </h1>
      <p class="text-lede lede">
        A doctor who writes code, working across clinical medicine, digital-health
        policy, and the messy seams between them.
      </p>
      <p class="pivot">
        Lately I'm moving toward neuroscience, neurorehabilitation, and
        brain–computer interfaces — where the clinical and the computational stop
        being separate jobs.
      </p>
      <p class="proof text-meta">
        Clinical expert, HTA Committee, Hellenic Ministry of Health (2026–present), with a
        focus on neurological therapies. <a href="/about">About</a> · <a href="/cv">CV</a>
      </p>
    </div>
    <div class="motif" aria-hidden="true">
      <div class="disc"></div>
      <div class="barv"></div>
      <div class="ring"></div>
      <div class="sq"></div>
    </div>
  </section>

  {
    posts.length > 0 && (
      <section class="container writing">
        <SectionHead title="Writing" count={`${posts.length} ${posts.length === 1 ? 'piece' : 'pieces'}`} moreHref="/posts" moreLabel="all posts →" />
        <div class="feature">
          <PostCard post={lead} featured />
        </div>
        {rest.length > 0 && (
          <div class="grid">
            {rest.map((p) => (
              <PostCard post={p} />
            ))}
          </div>
        )}
        <p class="closing">
          <span class="text-meta">More about me</span>
          <a href="/about" class="link-plain">About</a>
          <a href="/cv" class="link-plain">CV</a>
          <a href="/contact" class="link-plain">Contact</a>
        </p>
      </section>
    )
  }
</BaseLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1fr 16rem;
    gap: var(--space-6);
    align-items: start;
    padding-block: var(--space-6) var(--space-5);
  }

  .eyebrow {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--cobalt-deep);
    letter-spacing: 0.04em;
    margin-bottom: var(--space-3);
  }

  h1 {
    margin-bottom: var(--space-4);
  }

  .last-line {
    color: var(--vermilion);
  }

  .lede {
    max-width: 38ch;
    margin-bottom: var(--space-3);
  }

  /* The second beat of the thesis (the pivot is the site's first success
     measure), so full ink, not the muted secondary tone. */
  .pivot {
    max-width: 46ch;
  }

  /* The pivot's evidence, set as an annotation under it: one real, checkable
     fact from cv.yaml and the two pages that back it up. */
  .proof {
    max-width: 46ch;
    margin-top: var(--space-3);
    color: var(--ink-soft);
  }

  /* Geometric motif — same visual vocabulary as the generated covers. All
     sizes run off --u, so the wide screens can scale it up to hold the right
     column instead of leaving a blank strip beside the text. */
  .motif {
    --u: 1rem;
    --ring-border: 6px;
    position: relative;
    height: calc(15 * var(--u));
    margin-top: var(--space-2);
  }

  .motif .disc {
    position: absolute;
    width: calc(7.4 * var(--u));
    height: calc(7.4 * var(--u));
    border-radius: 50%;
    background: var(--cobalt);
    top: 0;
    right: calc(1.2 * var(--u));
  }

  .motif .barv {
    position: absolute;
    width: calc(2.1 * var(--u));
    height: calc(12 * var(--u));
    background: var(--vermilion);
    top: calc(1.6 * var(--u));
    right: calc(6 * var(--u));
  }

  .motif .ring {
    position: absolute;
    width: calc(3.7 * var(--u));
    height: calc(3.7 * var(--u));
    border: var(--ring-border) solid var(--ink);
    border-radius: 50%;
    bottom: calc(1.6 * var(--u));
    right: calc(9.4 * var(--u));
  }

  .motif .sq {
    position: absolute;
    width: calc(4.4 * var(--u));
    height: calc(4.4 * var(--u));
    background: var(--ochre);
    bottom: calc(0.5 * var(--u));
    right: 0;
  }

  @media (min-width: 1100px) {
    .hero {
      grid-template-columns: 1fr 25rem;
    }

    .motif {
      --u: 1.6rem;
      --ring-border: 9px;
    }
  }

  .writing {
    padding-block: var(--space-5) var(--space-4);
  }

  .feature {
    margin-bottom: var(--space-5);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-5);
  }

  /* The page ends on a way onward, not on the last card. Mono lead-in and
     plain links under a hairline: no buttons (none anywhere on the site). */
  .closing {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2) var(--space-4);
    margin-top: var(--space-6);
    padding-top: var(--space-4);
    border-top: var(--border-hair);
  }

  .closing a {
    position: relative;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.94rem;
    color: var(--cobalt-deep);
    border-bottom: 2px solid transparent;
    transition: border-color var(--transition-quick);
  }

  .closing a:hover {
    border-color: var(--cobalt);
  }

  /* Touch: stretch the hit area to ~44px without moving the text. */
  @media (pointer: coarse) {
    .closing a::before {
      content: '';
      position: absolute;
      inset: -0.8rem -0.5rem;
    }
  }

  /* The cards' own side-by-side switch (PostCard) covers 641–820px; below that
     they stack. Keep the 820 cut in step with PostCard's rule. */
  @media (max-width: 820px) {
    .hero {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }

    /* The motif stays on phones as a small strip of the same four shapes
       under the text, so the poster identity isn't lost with the wide layout. */
    .motif {
      display: flex;
      align-items: flex-end;
      gap: var(--space-3);
      height: 3rem;
      margin-top: 0;
    }

    .motif .disc,
    .motif .barv,
    .motif .ring,
    .motif .sq {
      position: static;
      flex: none;
    }

    .motif .disc {
      width: 3rem;
      height: 3rem;
    }

    .motif .barv {
      width: 0.9rem;
      height: 3rem;
    }

    .motif .ring {
      width: 2.1rem;
      height: 2.1rem;
      border-width: 4px;
    }

    .motif .sq {
      width: 1.9rem;
      height: 1.9rem;
    }

    .grid {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }
  }
</style>
